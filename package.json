{
  "name": "practice-gherkin-tests",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "wdio": "wdio run ./wdio.conf.js",
    "test": "cucumber-js",
    "test:smoke": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@smoke'",
    "test:regression": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@regression'",
    "test:login": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@login'",
    "test:registration": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@registration'",
    "test:search": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@search'",
    "test:view": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@view'",
    "test:addCart": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@addCart'",
    "test:checkout": "wdio run wdio.conf.js --cucumberOpts.tagExpression '@checkout'"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@wdio/allure-reporter": "^9.18.0",
    "@wdio/cli": "^9.16.2",
    "@wdio/cucumber-framework": "^9.18.0",
    "@wdio/local-runner": "^9.16.2",
    "@wdio/spec-reporter": "^9.16.2",
    "chai": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-cucumber": "^2.0.0",
    "eslint-plugin-wdio": "^9.16.2",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  }
}
