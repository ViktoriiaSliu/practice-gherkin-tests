{
  "name": "practice-gherkin-tests",
  "type": "module",
  "scripts": {
    "format": "prettier --write \"./**/*.{js,json,css,md}\"",
    "format:check": "prettier --check \"./**/*.{js,json,css,md}\"",
    "lint": "eslint \"./**/*.{js,mjs,cjs}\"",
    "lint:fix": "eslint --fix \"./**/*.{js,mjs,cjs}\"",
    "wdio": "wdio run ./wdio.conf.js",
    "test": "npm run lint && npm run wdio"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@wdio/allure-reporter": "^9.18.0",
    "@wdio/cli": "^9.16.2",
    "@wdio/local-runner": "^9.16.2",
    "@wdio/mocha-framework": "^9.16.2",
    "@wdio/spec-reporter": "^9.16.2",
    "chai": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-mocha": "^11.1.0",
    "eslint-plugin-wdio": "^9.16.2",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  }
}
